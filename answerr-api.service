[Unit]
Description=answerr Decision API (policy kernel + werr research engine)
Documentation=https://api.answerr.me/docs
After=network.target

[Service]
Type=simple
User=pcworm
Group=pcworm
WorkingDirectory=/opt/apps/answerr/api
EnvironmentFile=-/etc/answerr/answerr.env
ExecStart=/opt/apps/answerr/venv/bin/uvicorn server:app --host 127.0.0.1 --port 8560 --workers 2 --log-level info --no-proxy-headers
Restart=always
RestartSec=3

# Tenant gate store (ANSWERR_GATES_PATH defaults to /var/lib/answerr/gates.json)
StateDirectory=answerr
StateDirectoryMode=0750

# Sandboxing
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/apps/answerr/api /opt/apps/answerr/logs /var/lib/answerr
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
UMask=0027

# Resource ceilings
MemoryHigh=200M
MemoryMax=256M
CPUQuota=25%
TasksMax=64
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
